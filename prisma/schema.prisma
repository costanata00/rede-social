generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1:N — um autor tem muitos posts.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  // Nunca a senha em texto puro — só o hash gerado pelo bcrypt
  // (ver src/auth/passwords.ts). Mesmo um vazamento do banco não expõe a senha.
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  posts Post[]

  // Autorrelação N:N — User segue User, via tabela de junção explícita
  // (precisa ser explícita porque tem duas relações diferentes com User:
  // "quem segue" e "quem é seguido").
  following Follow[] @relation("follower")
  followers Follow[] @relation("following")


  likes Like[]
  comments Comment[]

}

model Follow {
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  // URL pública do arquivo no S3 (ou no storage local, em dev) — o binário
  // da imagem nunca é salvo no banco, só o endereço dele. Ver src/uploads/.
  imageUrl  String?
  createdAt DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // N:N implícita — o Prisma cria e gerencia a tabela de junção sozinho.
  tags Tag[]

  likes Like[]
  comments Comment[]
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model Like {
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  authorId Int
  postId   Int
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}